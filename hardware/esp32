const uint8_t LEDS[2][3] = {
  {LED_L_VERDE, LED_L_ROJO, LED_L_AMARILLO},
  {LED_S_VERDE, LED_S_ROJO, LED_S_AMARILLO}
};

// Codigos del control remoto que ya funcionaron en LavaRESI.
