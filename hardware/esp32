const uint8_t MAX_TANDAS = 3;
const uint8_t MAX_SOLICITUDES = 8;

// Cuentas ficticias, para verificar varias posiciones de cola SIN backend.
// No usar estos PIN en produccion: deberan venir de la base de datos.
struct UsuarioDemo {
