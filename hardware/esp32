// -------------------- OPERACIONES REALES EN FASTAPI --------------------
void errorOperacionAPI(const String &respuesta, int codigo, Pantalla siguiente) {
  String detalle = errorAPI(respuesta, codigo);
  Serial.println("API: " + detalle);
  // LCD 16x2: mensaje corto; error completo queda en monitor serial.
  if (codigo == 401 && detalle.indexOf("Terminal") >= 0)
    avisar("Terminal no", "autorizada", siguiente);
  else if (codigo == 401)
    avisar("PIN incorrecto", "Intente otra vez", siguiente);
  else if (codigo == 409) avisar("No autorizado", "Revise su turno", siguiente);
  else if (codigo == 429) avisar("Muchos intentos", "Espere 1 minuto", siguiente);
  else if (codigo <= 0) avisar("Sin conexion", "Revise WiFi/API", siguiente);
  else avisar("Error servidor", "Ver Monitor", siguiente);
}

void procesarPinEquipoAPI() {
  String pin = entrada;
  entrada = "";
  if (pin.length() != 4) {
    avisar("PIN de 4 digitos", "Intente otra vez", PIN_EQUIPO); return;
  }
  if (!apiDisponible) {
    avisar("Sin conexion", "Revise backend", EQUIPO); return;
  }
  // Una sola peticion POST: antes se verificaba el mismo PIN dos veces.
  String respuesta; int codigo = -1;
  if (!consultarMiTurnoAPI(pin, true, &codigo, &respuesta)) {
    if (codigo < 200 || codigo >= 300)
      errorOperacionAPI(respuesta, codigo, PIN_EQUIPO);
    else
      avisar("Error JSON", "Revise servidor", PIN_EQUIPO);
    return;
  }
  TurnoCuenta &t = turnosCuenta[maquina];
  MaquinaRemota &m = maquinasAPI[maquina];
  if (t.id > 0 && t.id == m.ocupanteId && m.estado == "PENDIENTE_RETIRO") {
    JsonDocument retirar; retirar["pin"] = pin; retirar["maquina_id"] = maquina + 1;
    String datos; serializeJson(retirar, datos);
    if (!peticionAPI("/api/terminal/ciclos/retirar", "POST", datos, respuesta, codigo)) {
      errorOperacionAPI(respuesta, codigo, EQUIPO); return;
    }
    JsonDocument r; deserializeJson(r, respuesta);
    String resultado = String((const char*)(r["resultado"] | ""));
    ultimoCambioConfirmadoMs = millis();
    // La API ya confirmo el retiro: actualizar la LCD y RGB AHORA,
    // sin esperar 2 consultas adicionales a Neon.
    iniciarPitidos(2);
    m.segundos = 0;
    sincronizacionMaquinaMs[maquina] = millis();
    if (resultado == "CONTINUAR_TANDAS") {
      m.estado = "ENTRE_TANDAS";
      equipos[maquina].estado = PREPARANDO;
      actualizarLeds();
      entrada = "";
      avisar("Tanda retirada", "Sigue otra tanda", TIEMPO, 1450);
    } else {
      m.estado = "LIBRE";
      m.ocupanteId = -1;
      m.ocupanteNombre = "";
      equipos[maquina].estado = LIBRE;
      turnosCuenta[maquina] = TurnoCuenta();
      actualizarLeds();
      avisar("Ropa retirada", "Equipo libre", MENU, 1450);
    }
    return;
  }
  if (t.id < 0) {
    tandasElegidas = 1;
    pantalla = TANDAS;
    mostrarVista();
  } else if ((m.estado == "LIBRE" && t.estado == "AUTORIZADA") ||
             (m.estado == "ENTRE_TANDAS" && t.id == m.ocupanteId)) {
    pedirTiempo();
  } else if (t.id == m.ocupanteId && m.estado == "EN_USO") {
    avisar("Ciclo en marcha", "Consulte tiempo", EQUIPO);
  } else {
    avisar("Turno registrado", "Puesto: " + String(t.posicion), EQUIPO, 1600);
  }
}

