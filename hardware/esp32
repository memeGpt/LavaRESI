void registrarTandasAPI() {
  if (pinCuenta.length() != 4) { avisar("Ingrese su PIN", "Otra vez", EQUIPO); return; }
  JsonDocument req;
  req["pin"] = pinCuenta;
  req["maquina_id"] = maquina + 1; // Backend usa 1 lavadora / 2 secadora.
  req["tandas"] = tandasElegidas;
  String cuerpo; serializeJson(req, cuerpo);
  String respuesta; int codigo;
  if (!peticionAPI("/api/terminal/solicitudes", "POST", cuerpo, respuesta, codigo)) {
    errorOperacionAPI(respuesta, codigo, EQUIPO); return;
  }
  ultimoCambioConfirmadoMs = millis();
  // La respuesta del POST trae el turno confirmado; no duplicar consultas.
  JsonDocument creado;
  if (deserializeJson(creado, respuesta)) {
    avisar("Error JSON", "Revise servidor", EQUIPO); return;
  }
  TurnoCuenta &t = turnosCuenta[maquina];
  t.id = creado["id"] | -1;
  t.estado = String((const char*)(creado["estado"] | ""));
  t.iniciadas = creado["tandas_iniciadas"] | 0;
  t.total = creado["tandas_totales"] | 0;
  t.posicion = creado["posicion"] | 0;
  if (t.estado == "AUTORIZADA" && maquinasAPI[maquina].estado == "LIBRE") {
    pedirTiempo();
  } else {
    avisar("Turno registrado", "Puesto: " + String(t.posicion), EQUIPO, 1650);
  }
}

void iniciarCicloAPI(unsigned int minutos) {
  if (minutos < 1 || minutos > 180) {
    entrada = ""; avisar("Tiempo invalido", "Ingrese 1-180", TIEMPO); return;
  }
  JsonDocument req;
  req["pin"] = pinCuenta;
  req["maquina_id"] = maquina + 1;
  req["minutos"] = minutos;
  String cuerpo; serializeJson(req, cuerpo);
  String respuesta; int codigo;
  const unsigned long solicitudEnviadaMs = millis();
  if (!peticionAPI("/api/terminal/ciclos/iniciar", "POST", cuerpo, respuesta, codigo)) {
    errorOperacionAPI(respuesta, codigo, EQUIPO); return;
  }
  // El reloj comienza en el BACKEND al aceptar la solicitud.
  // Descontar una estimacion del trayecto de ida y respuesta.
  const unsigned long duracionSeg = (unsigned long)minutos * 60UL;
  const unsigned long viajeSeg = (millis() - solicitudEnviadaMs) / 1000UL;
  const unsigned long segundosIniciales = viajeSeg >= duracionSeg ? 0 : duracionSeg - viajeSeg;
  ultimoCambioConfirmadoMs = millis();
  // El servidor AUTORIZO el ciclo. Mostrarlo inmediatamente,
  // sin consumir los primeros segundos en dos solicitudes HTTP extra.
  TurnoCuenta &t = turnosCuenta[maquina];
  if (t.id > 0) {
    t.iniciadas++;
    t.estado = "EN_USO";
  }
  MaquinaRemota &m = maquinasAPI[maquina];
  m.estado = "EN_USO";
  m.segundos = segundosIniciales;
  m.ocupanteId = t.id;
  m.ocupanteNombre = nombreCuenta;
  m.ocupanteIniciadas = t.iniciadas;
  m.ocupanteTotal = t.total;
  sincronizacionMaquinaMs[maquina] = millis();
  equipos[maquina].estado = EN_USO;
  equipos[maquina].restantes = segundosIniciales;
  actualizarLeds();
  irEquipo();
  iniciarPitidos(2);
}

void revisarAPI() {
  if (!MODO_API_REAL || !mutexEstadoHTTP) return;
  String respuesta;
  int codigo = -1;
  unsigned long inicioConsulta = 0;
  bool listo = false;
  if (xSemaphoreTake(mutexEstadoHTTP, 0) == pdTRUE) {
    if (hayEstadoPendiente) {
      respuesta = respuestaEstadoPendiente;
      codigo = codigoEstadoPendiente;
      inicioConsulta = inicioConsultaEstadoPendienteMs;
      hayEstadoPendiente = false;
      listo = true;
    }
    xSemaphoreGive(mutexEstadoHTTP);
  }
  if (!listo) {
    // Incluso si el WiFi se desconecta sin respuesta HTTP, no conservar
    // indefinidamente un estado de las maquinas que puede ser obsoleto.
    if (apiDisponible && WiFi.status() != WL_CONNECTED &&
        millis() - ultimoEstadoCorrectoMs > 12000UL) {
      apiDisponible = false;
      apagarRgbPorConexion();
      if (pantalla == EQUIPO || pantalla == COLA_CONSULTA) mostrarVista();
    }
    return;
  }
  // Ignorar respuestas cuya solicitud comenzo antes de un POST confirmado.
  // Evita mostrar LIBRE inmediatamente despues de haber iniciado un ciclo.
  if (ultimoCambioConfirmadoMs != 0 &&
      (long)(inicioConsulta - ultimoCambioConfirmadoMs) < 0) return;
  if (codigo == 200) {
    if (aplicarEstadoAPI(respuesta)) {
      if (pantalla == EQUIPO || pantalla == COLA_CONSULTA || pantalla == VER_MI_TURNO)
        mostrarVista();
    }
  } else {
    Serial.printf("API estado temporalmente no disponible, HTTP %d\n", codigo);
    // Un error momentaneo NO apaga RGBs ni falsifica estados de maquinas.
    // Solo tras 12 segundos sin respuesta correcta indicamos desconexion.
    if (!apiSincronizada || millis() - ultimoEstadoCorrectoMs > 12000UL) {
      apiDisponible = false;
      apagarRgbPorConexion();
      if (pantalla == EQUIPO || pantalla == COLA_CONSULTA) mostrarVista();
    }
  }
}

// -------------------- INICIO Y RETIRO DE TANDAS --------------------
void iniciarCiclo(unsigned int minutos) {
  if (MODO_API_REAL) { iniciarCicloAPI(minutos); return; }
  int idx = buscarSolicitud(maquina, usuarioActual);
  if (idx < 0) {
    avisar("Sin solicitud", "Registre turno", EQUIPO);
    return;
  }
  Equipo &e = equipos[maquina];
  if (colas[maquina][idx].iniciadas >= colas[maquina][idx].total) {
    avisar("Sin tandas", "pendientes", EQUIPO);
    return;
  }
  if (e.estado == LIBRE) {
    if (primeraSolicitudDisponible(maquina) != idx) {
      avisar("Aun no es turno", "Revise la cola", EQUIPO);
      return;
    }
    e.dueno = usuarioActual;
  } else if (!(e.estado == PREPARANDO && e.dueno == usuarioActual)) {
    avisar("Equipo ocupado", "Espere turno", EQUIPO);
    return;
  }
  colas[maquina][idx].iniciadas++;
  e.estado = EN_USO;
  e.restantes = (unsigned long)minutos * 60UL;
  e.ultimoTick = millis();
  actualizarLeds();
  iniciarPitidos(2);
  Serial.println("Inicio " + etiquetaMaquina(maquina) + " / " + nombreUsuario(usuarioActual) +
                 " / tanda " + textoTandas(maquina, idx));
  irEquipo();
}

void confirmarRetiro(int usuario) {
  Equipo &e = equipos[maquina];
  if (e.estado != TERMINADO || e.dueno != usuario) {
    avisar("Retiro denegado", "Sin autorizacion", EQUIPO);
    return;
  }
  int idx = buscarSolicitud(maquina, usuario);
  if (idx < 0) {
    avisar("Error de turno", "Revise solicitud", EQUIPO);
    return;
  }
  e.restantes = 0;
  iniciarPitidos(2);
  if (colas[maquina][idx].iniciadas < colas[maquina][idx].total) {
    // Tanda intermedia: el dueno retiene la maquina y coloca la siguiente.
    e.estado = PREPARANDO;
    actualizarLeds();
    avisar("Tanda retirada", "Sigue otra tanda", TIEMPO, 1450);
  } else {
    // SOLO el ultimo retiro libera realmente la maquina.
    borrarSolicitud(maquina, idx);
    e.estado = LIBRE;
    e.dueno = -1;
    actualizarLeds();
    avisar("Ropa retirada", "Equipo libre", MENU, 1450);
  }
}

void procesarPinEquipo() {
  if (MODO_API_REAL) { procesarPinEquipoAPI(); return; }
  int id = -1;
  for (int i = 0; i < NUM_USUARIOS; i++) {
    if (entrada == usuarios[i].pin) { id = i; break; }
  }
  if (id < 0) {
    avisar("PIN incorrecto", "Intente otra vez", PIN_EQUIPO);
    entrada = "";
    return;
  }
  usuarioActual = id;
  entrada = "";
  Equipo &e = equipos[maquina];
  int idx = buscarSolicitud(maquina, id);

  if (e.dueno == id) {
    if (e.estado == TERMINADO) {
      confirmarRetiro(id); // PIN del propietario confirmado.
    } else if (e.estado == PREPARANDO) {
      pedirTiempo();
    } else {
      avisar("Ciclo en marcha", "Consulte tiempo", EQUIPO);
    }
    return;
  }

  if (idx < 0) {
    tandasElegidas = 1;
    pantalla = TANDAS;
    mostrarVista();
    return;
  }
  if (e.estado == LIBRE && primeraSolicitudDisponible(maquina) == idx) {
    pedirTiempo();
  } else {
    avisar("Turno registrado", "Puesto: " + String(puestoVisible(maquina, id)), EQUIPO, 1600);
  }
}

void procesarPinMiTurno() {
  if (MODO_API_REAL) { procesarPinMiTurnoAPI(); return; }
  int id = -1;
  for (int i = 0; i < NUM_USUARIOS; i++) {
    if (entrada == usuarios[i].pin) { id = i; break; }
  }
  if (id < 0) {
    avisar("PIN incorrecto", "Intente otra vez", PIN_MI_TURNO);
    entrada = "";
    return;
  }
  usuarioActual = id;
  maquinaConsulta = 0;
  entrada = "";
  pantalla = VER_MI_TURNO;
  mostrarVista();
}

void registrarTandas() {
  if (MODO_API_REAL) { registrarTandasAPI(); return; }
  int idx = agregarSolicitud(maquina, usuarioActual, tandasElegidas);
  if (idx < 0) {
    avisar("Cola completa", "Intente despues", EQUIPO);
    return;
  }
  Serial.println("Solicitud demo: " + etiquetaMaquina(maquina) + ", " +
                 nombreUsuario(usuarioActual) + ", " + String(tandasElegidas) + " tandas");
  if (equipos[maquina].estado == LIBRE && primeraSolicitudDisponible(maquina) == idx) {
    pedirTiempo();
  } else {
    avisar("Turno registrado", "Puesto: " + String(puestoVisible(maquina, usuarioActual)), EQUIPO, 1650);
  }
}

// -------------------- ENTRADAS Y NAVEGACION --------------------
void abrirConsulta() {
  if (opcionConsulta == 0 || opcionConsulta == 1) {
    maquinaConsulta = opcionConsulta;
    desplazamientoCola = 0;
    pantalla = COLA_CONSULTA;
    mostrarVista();
  } else {
    pedirPin(PIN_MI_TURNO);
  }
}

void confirmar() {
  if (pantalla == AVISO) return;
  switch (pantalla) {
    case MENU:
      if (opcionMenu < 2) {
        maquina = opcionMenu;
        irEquipo();
      } else {
        pantalla = MENU_CONSULTAS;
        opcionConsulta = 0;
        mostrarVista();
      }
      break;
    case EQUIPO:
      pedirPin(PIN_EQUIPO);
      break;
    case PIN_EQUIPO:
      procesarPinEquipo();
      break;
    case TANDAS:
      registrarTandas();
      break;
    case TIEMPO: {
      int minutos = entrada.toInt();
      if (minutos < 1 || minutos > 180) {
        entrada = "";
        avisar("Tiempo invalido", "Ingrese 1-180", TIEMPO);
      } else {
        iniciarCiclo(minutos);
      }
      break;
    }
    case MENU_CONSULTAS:
      abrirConsulta();
      break;
    case COLA_CONSULTA:
    case VER_MI_TURNO:
      break;
    case PIN_MI_TURNO:
      procesarPinMiTurno();
      break;
    case AVISO:
      break;
  }
}

void regresar() {
  switch (pantalla) {
    case MENU:
      return;
    case EQUIPO:
      irMenu();
      return;
    case MENU_CONSULTAS:
      irMenu();
      return;
    case COLA_CONSULTA:
    case PIN_MI_TURNO:
    case VER_MI_TURNO:
      pantalla = MENU_CONSULTAS;
      mostrarVista();
      return;
    case AVISO:
      irMenu();
      return;
    default:
      irEquipo();
      return;
  }
}

// FUNC/STOP solo vuelve al menu; NUNCA cancela un ciclo activo.
void funcionStop() { irMenu(); }

void seleccionarArriba() {
  switch (pantalla) {
    case MENU: if (opcionMenu > 0) --opcionMenu; break;
    case MENU_CONSULTAS: if (opcionConsulta > 0) --opcionConsulta; break;
    case TANDAS: if (tandasElegidas < MAX_TANDAS) ++tandasElegidas; break;
    case COLA_CONSULTA: if (desplazamientoCola > 0) --desplazamientoCola; break;
    case VER_MI_TURNO: maquinaConsulta = 0; break;
    default: return;
  }
  mostrarVista();
}

void seleccionarAbajo() {
  switch (pantalla) {
    case MENU: if (opcionMenu < 2) ++opcionMenu; break;
    case MENU_CONSULTAS: if (opcionConsulta < 2) ++opcionConsulta; break;
    case TANDAS: if (tandasElegidas > 1) --tandasElegidas; break;
    case COLA_CONSULTA:
      if (desplazamientoCola + 1 < (MODO_API_REAL ? maquinasAPI[maquinaConsulta].cantidad : cantidadCola[maquinaConsulta])) ++desplazamientoCola;
      break;
    case VER_MI_TURNO: maquinaConsulta = 1; break;
    default: return;
  }
  mostrarVista();
}

void agregarNumero(int n) {
  if (pantalla == MENU && n >= 1 && n <= 3) {
    opcionMenu = n - 1;
    confirmar();
    return;
  }
  if (pantalla == MENU_CONSULTAS && n >= 1 && n <= 3) {
    opcionConsulta = n - 1;
    abrirConsulta();
    return;
  }
  if (pantalla == TANDAS && n >= 1 && n <= MAX_TANDAS) {
    tandasElegidas = n;
    mostrarVista();
    return;
  }
  if (pantalla != PIN_EQUIPO && pantalla != PIN_MI_TURNO && pantalla != TIEMPO) return;
  size_t maximo = pantalla == TIEMPO ? 3 : 4;
  if (entrada.length() >= maximo) return;
  entrada += String(n);
  mostrarVista();
}

int codigoANumero(uint8_t codigo) {
  switch (codigo) {
    case 0x16: return 0;
    case 0x0C: return 1;
    case 0x18: return 2;
    case 0x5E: return 3;
    case 0x08: return 4;
    case 0x1C: return 5;
    case 0x5A: return 6;
    case 0x42: return 7;
    case 0x52: return 8;
    case 0x4A: return 9;
    default: return -1;
  }
}

void revisarControl() {
  if (!IrReceiver.decode()) return;
  if (!(IrReceiver.decodedIRData.flags & IRDATA_FLAGS_IS_REPEAT)) {
    uint8_t codigo = IrReceiver.decodedIRData.command;
    Serial.printf("IR recibido: 0x%02X\n", codigo);
    if (codigo == IR_ARRIBA) seleccionarArriba();
    else if (codigo == IR_ABAJO) seleccionarAbajo();
    else if (codigo == IR_IZQUIERDA) regresar();
    else if (codigo == IR_DERECHA) {
      if (pantalla == MENU || pantalla == MENU_CONSULTAS || pantalla == EQUIPO) confirmar();
    } else if (codigo == IR_FUNC_STOP) funcionStop();
    else if (codigo == IR_PLAY_OK) confirmar();
    else {
      int n = codigoANumero(codigo);
      if (n >= 0) agregarNumero(n);
    }
  }
  IrReceiver.resume();
}

void revisarJoystick() {
  int y = analogRead(JOY_Y);
  int x = analogRead(JOY_X);
  bool permiteVertical = pantalla == MENU || pantalla == MENU_CONSULTAS ||
                         pantalla == TANDAS || pantalla == COLA_CONSULTA ||
                         pantalla == VER_MI_TURNO;
  if (permiteVertical && !joyVerticalActivo) {
    if (y < 1200) { seleccionarArriba(); joyVerticalActivo = true; }
    else if (y > 2800) { seleccionarAbajo(); joyVerticalActivo = true; }
  }
  if (y > 1600 && y < 2500) joyVerticalActivo = false;

  if (!joyHorizontalActivo && (x < 1200 || x > 2800)) {
    regresar();
    joyHorizontalActivo = true;
  }
  if (x > 1600 && x < 2500) joyHorizontalActivo = false;

  bool boton = digitalRead(JOY_SW);
  if (boton == LOW && botonAnterior == HIGH && millis() - ultimoBoton > 250) {
    ultimoBoton = millis();
    confirmar();
  }
  botonAnterior = boton;
}

// -------------------- DOS TEMPORIZADORES SIMULTANEOS --------------------
void actualizarCiclos() {
  if (MODO_API_REAL) return; // Tiempo autoritativo = backend PostgreSQL.
  unsigned long ahora = millis();
  for (int m = 0; m < 2; m++) {
    Equipo &e = equipos[m];
    if (e.estado != EN_USO) continue;
    unsigned long segundos = (ahora - e.ultimoTick) / 1000UL;
    if (segundos == 0) continue;
    e.ultimoTick += segundos * 1000UL;
    if (segundos >= e.restantes) {
      e.restantes = 0;
      e.estado = TERMINADO;
      actualizarLeds();
      iniciarPitidos(3);
      Serial.println(m == 0 ? "Lavadora terminada" : "Secadora terminada");
    } else {
      e.restantes -= segundos;
    }
    if (pantalla == EQUIPO && maquina == m) mostrarVista();
  }
}

// Prueba opcional de ausencia desde el Monitor Serial (115200):
// DISP 2345 0 -> Kelvin no disponible; DISP 2345 1 -> disponible.
// No sustituye el futuro cambio de disponibilidad desde la WEB.
void procesarComandoDemo(String comando) {
  comando.trim();
  if (!comando.startsWith("DISP ")) return;
  int separador = comando.indexOf(' ', 5);
  if (separador < 0) return;
  String pin = comando.substring(5, separador);
  String valor = comando.substring(separador + 1);
  valor.trim();
  if (valor != "0" && valor != "1") return;
  for (int i = 0; i < NUM_USUARIOS; i++) {
    if (pin == usuarios[i].pin) {
      usuarios[i].disponible = (valor == "1");
      Serial.println(nombreUsuario(i) + (usuarios[i].disponible ? " DISPONIBLE" : " NO DISPONIBLE"));
      if (pantalla == COLA_CONSULTA || pantalla == VER_MI_TURNO) mostrarVista();
      return;
    }
  }
}

void revisarSerialDemo() {
  static String buffer = "";
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (buffer.length()) { procesarComandoDemo(buffer); buffer = ""; }
    } else if (buffer.length() < 40) {
      buffer += c;
    }
  }
}

const char* URL_BACKEND = "http://192.168.137.1:8000/api/health";
bool pruebaBackendRealizada = false;

void probarConexionBackend() {
  if (pruebaBackendRealizada || WiFi.status() != WL_CONNECTED) {
    return;
  }

  pruebaBackendRealizada = true;

  WiFiClient cliente;
  HTTPClient http;

  http.setConnectTimeout(1500);
  http.setTimeout(1500);

  if (!http.begin(cliente, URL_BACKEND)) {
    Serial.println("No se pudo iniciar la solicitud HTTP");
    return;
  }

  Serial.println("Consultando backend LavaRESI...");

  int codigo = http.GET();

  if (codigo == 200) {
    Serial.println("Backend conectado correctamente!");
    Serial.println(http.getString());
  } else if (codigo > 0) {
    Serial.printf("Respuesta HTTP: %d\n", codigo);
  } else {
    Serial.print("Error de conexion: ");
    Serial.println(http.errorToString(codigo));
  }

  http.end();
}


void setup() {
  Serial.begin(115200);
  Serial2.begin(9600, SERIAL_8N1, 16, 17); // Mismo TX17 -> UNO D2.
  prepararBuzzer();
  pinMode(JOY_SW, INPUT_PULLUP);
  analogReadResolution(12);
  prepararYProbarLeds();
  if (MODO_API_REAL) apagarRgbPorConexion(); // No asumir libres antes de sincronizar.
  IrReceiver.begin(IR_PIN, ENABLE_LED_FEEDBACK);

  delay(1200);
  Serial.println("=== LavaRESI: terminal integrada con FastAPI ===");
  if (!MODO_API_REAL)
    Serial.println("Modo demostracion local activado.");
  Serial.println("Control remoto, joystick, 2 RGB, buzzer y dos ciclos independientes.");
  lcdEnviar("LavaRESI", "Terminal lista");
  delay(1400);
  irMenu();
  iniciarWiFi(); // No esperamos a conectar: el sistema queda operativo.
  if (MODO_API_REAL) prepararEstadoHTTP();
}

void loop() {
  actualizarWiFi();
  actualizarCiclos();
  actualizarAviso();
  revisarControl();
  revisarJoystick();
  revisarSerialDemo();
  // /api/health solo se usa para diagnosticos manuales, no cada arranque.
  revisarAPI(); // Consume las respuestas HTTP recibidas en tarea independiente.

  // El tiempo de la LCD se dibuja cada segundo entre consultas HTTP.
  // lcdEnviar evita retransmitir cuando el texto no ha cambiado.
  static unsigned long ultimoRefrescoLCD = 0;
  if (MODO_API_REAL && apiDisponible && pantalla == EQUIPO &&
      maquinasAPI[maquina].estado == "EN_USO" &&
      millis() - ultimoRefrescoLCD >= 200UL) {
    ultimoRefrescoLCD = millis();
    mostrarVista();
  }
  delay(20);
}
