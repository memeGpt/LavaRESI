// -------------------- WIFI SIN ESPERAS BLOQUEANTES --------------------
// El ESP32 utiliza el Wi-Fi local; el UNO sigue dedicado a la LCD.
// IMPORTANTE: por ahora el Wi-Fi NO autentica usuarios ni autoriza turnos.
unsigned long ultimaRevisionWiFi = 0;
unsigned long ultimoReintentoWiFi = 0;
wl_status_t estadoWiFiAnterior = WL_IDLE_STATUS;

void iniciarWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("WiFi: conectando a ");
  Serial.println(WIFI_SSID);
}

void actualizarWiFi() {
  unsigned long ahora = millis();
  if (ahora - ultimaRevisionWiFi < 1000UL) return;
  ultimaRevisionWiFi = ahora;

  wl_status_t estado = WiFi.status();
  if (estado != estadoWiFiAnterior) {
    if (estado == WL_CONNECTED) {
      Serial.print("WiFi conectado! Direccion IP del ESP32: ");
      Serial.println(WiFi.localIP());
    } else if (estadoWiFiAnterior == WL_CONNECTED) {
      Serial.println("WiFi desconectado; temporizadores locales siguen activos.");
    } else {
      Serial.print("WiFi: estado ");
      Serial.println((int)estado);
    }
    estadoWiFiAnterior = estado;
  }

  // Reintento sin 'while' ni delays; los controles y ciclos siguen atendidos.
  if (estado != WL_CONNECTED && ahora - ultimoReintentoWiFi >= 20000UL) {
    ultimoReintentoWiFi = ahora;
    Serial.println("WiFi: reintentando conexion...");
    WiFi.reconnect();
  }
}

// -------------------- BUZZER INDEPENDIENTE DE LA RED --------------------
// Buzzer activo con transistor PN2222A, GPIO26. Mantiene sonido corto
// aunque una solicitud HTTP al servidor tarde varios segundos.
const uint16_t DURACION_PITIDO_MS = 150;  // Igual a la version original probada.
const uint16_t PAUSA_PITIDO_MS = 140;
QueueHandle_t colaPitidos = nullptr;

void tareaBuzzer(void *parametro) {
  uint8_t cantidad = 0;
  for (;;) {
    if (xQueueReceive(colaPitidos, &cantidad, portMAX_DELAY) == pdTRUE) {
      cantidad = constrain(cantidad, 1, 3);
      for (uint8_t i = 0; i < cantidad; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        vTaskDelay(pdMS_TO_TICKS(DURACION_PITIDO_MS));
        digitalWrite(BUZZER_PIN, LOW);
        if (i + 1 < cantidad) {
          vTaskDelay(pdMS_TO_TICKS(PAUSA_PITIDO_MS));
        }
      }
      digitalWrite(BUZZER_PIN, LOW);
    }
  }
}

void prepararBuzzer() {
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  colaPitidos = xQueueCreate(4, sizeof(uint8_t));
  if (colaPitidos) {
    if (xTaskCreate(tareaBuzzer, "LR_buzzer", 3072, nullptr, 2, nullptr) != pdPASS) {
      Serial.println("AVISO: no se pudo crear la tarea del buzzer");
    }
  } else {
    Serial.println("AVISO: no se pudo crear cola del buzzer");
  }
}

// Eventos sonoros: iniciar=2, finalizar=3, retirar=2.
// Se usan tareas FreeRTOS: los tiempos no dependen del loop ni del HTTP.
void iniciarPitidos(uint8_t cantidad) {
  if (!colaPitidos || cantidad < 1 || cantidad > 3) return;
  xQueueSend(colaPitidos, &cantidad, 0);
}

// -------------------- RGB DE AMBAS MAQUINAS --------------------
// LAVADORA: R -> GPIO19, G -> GPIO18, B sin conectar, GND -> GND.
// SECADORA: R -> GPIO23, G -> GPIO22, B sin conectar, GND -> GND.
// Los dos modulos son RGB de catodo comun con resistencias incorporadas.
// GPIO21 y GPIO13 quedan sin LED conectado (eran los amarillos individuales).
// Verde = LIBRE; rojo = EN_USO o PREPARANDO;
// amarillo = TERMINADO (rojo fuerte + verde reducido con PWM).
// Si el amarillo de la secadora se ve muy verde o muy rojo,
// ajustar BRILLO_VERDE_AMARILLO_S por separado.
const uint8_t BRILLO_VERDE_AMARILLO_L = 65;  // Valor que ya probamos con la lavadora.
const uint8_t BRILLO_VERDE_AMARILLO_S = 65;  // Punto de partida para la secadora.

void actualizarRgb(int pinRojo, int pinVerde, EstadoEquipo estado, uint8_t verdeAmarillo) {
  if (estado == LIBRE) {
    analogWrite(pinRojo, 0);
    analogWrite(pinVerde, 255);
  } else if (estado == TERMINADO) {
    analogWrite(pinRojo, 255);
    analogWrite(pinVerde, verdeAmarillo);
  } else {  // EN_USO o PREPARANDO: sigue reservada.
    analogWrite(pinRojo, 255);
    analogWrite(pinVerde, 0);
  }
}

void actualizarLeds() {
  actualizarRgb(LED_L_ROJO, LED_L_VERDE, equipos[0].estado, BRILLO_VERDE_AMARILLO_L);
  actualizarRgb(LED_S_ROJO, LED_S_VERDE, equipos[1].estado, BRILLO_VERDE_AMARILLO_S);
  // Pines de los antiguos LED amarillos sin conexion fisica.
  digitalWrite(LED_L_AMARILLO, LOW);
  digitalWrite(LED_S_AMARILLO, LOW);
}

void probarUnRgb(int pinRojo, int pinVerde, uint8_t verdeAmarillo) {
  // Rojo
  analogWrite(pinRojo, 255);
  analogWrite(pinVerde, 0);
  delay(400);
  // Verde
  analogWrite(pinRojo, 0);
  analogWrite(pinVerde, 255);
  delay(400);
  // Amarillo ajustado: rojo + verde reducido
  analogWrite(pinRojo, 255);
  analogWrite(pinVerde, verdeAmarillo);
  delay(650);
  analogWrite(pinRojo, 0);
  analogWrite(pinVerde, 0);
  delay(150);
}

void prepararYProbarLeds() {
  // Mismos GPIO de los LED originales, no se agrega ninguno nuevo.
  for (int i = 0; i < 2; i++) {
    for (int j = 0; j < 3; j++) {
      digitalWrite(LEDS[i][j], LOW);
      pinMode(LEDS[i][j], OUTPUT);
    }
  }

  Serial.println("Prueba RGB lavadora: rojo, verde, amarillo");
  probarUnRgb(LED_L_ROJO, LED_L_VERDE, BRILLO_VERDE_AMARILLO_L);
  Serial.println("Prueba RGB secadora: rojo, verde, amarillo");
  probarUnRgb(LED_S_ROJO, LED_S_VERDE, BRILLO_VERDE_AMARILLO_S);
  actualizarLeds();  // Ambas maquinas comienzan disponibles (verde).
}

