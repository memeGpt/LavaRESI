// Devuelve true solo en HTTP 2xx. No revela el PIN en el monitor serie.
bool peticionAPI(const String &ruta, const char* metodo, const String &cuerpo,
                 String &respuesta, int &codigo) {
  respuesta = "";
  codigo = -1;
  if (WiFi.status() != WL_CONNECTED) {
    Serial.printf("API %s %s: WiFi desconectado (estado %d)\n",
                  metodo, ruta.c_str(), (int)WiFi.status());
    return false;
  }

  WiFiClient cliente;
  HTTPClient http;
  // La API abre transacciones con Neon. Un tiempo de 1.6 s puede ser insuficiente.
  http.setConnectTimeout(3000);
  http.setTimeout(8000);

  if (!http.begin(cliente, String(API_BASE) + ruta)) {
    Serial.printf("API %s %s: no se pudo iniciar HTTP\n", metodo, ruta.c_str());
    return false;
  }
  if (strlen(API_TERMINAL_KEY) > 0 &&
      (ruta.startsWith("/api/terminal/") || ruta == "/api/estado")) {
    http.addHeader("X-Terminal-Key", API_TERMINAL_KEY);
  }
  if (strcmp(metodo, "POST") == 0) {
    http.addHeader("Content-Type", "application/json");
    codigo = http.POST(cuerpo);
  } else {
    codigo = http.GET();
  }

  if (codigo > 0) {
    respuesta = http.getString();
    if (ruta != "/api/estado" || codigo != 200) {
      Serial.printf("API %s %s: HTTP %d, %u bytes\n",
                    metodo, ruta.c_str(), codigo, (unsigned)respuesta.length());
    }
  } else {
    Serial.printf("API %s %s: error %d (%s)\n",
                  metodo, ruta.c_str(), codigo,
                  http.errorToString(codigo).c_str());
  }
  http.end();
  return codigo >= 200 && codigo < 300;
}

String errorAPI(const String &respuesta, int codigo) {
  if (codigo <= 0) return "Sin conexion API";
  JsonDocument datos;
  if (!deserializeJson(datos, respuesta)) {
    String detalle = datos["detail"] | "";
    if (detalle.length()) return detalle;
  }
  return "Error HTTP " + String(codigo);
}

// Si no conocemos el estado real, no mostrar falsamente "disponible".
void apagarRgbPorConexion() {
  analogWrite(LED_L_ROJO, 0);
  analogWrite(LED_L_VERDE, 0);
  analogWrite(LED_S_ROJO, 0);
  analogWrite(LED_S_VERDE, 0);
}

// Las 2 maquinas se consultan en una sola peticion GET /api/estado.
bool aplicarEstadoAPI(const String &respuesta) {
  JsonDocument doc;
  if (deserializeJson(doc, respuesta)) {
    Serial.println("API: respuesta /api/estado no es JSON valido");
    apiDisponible = false;
    apagarRgbPorConexion();
    return false;
  }
  JsonArrayConst lista = doc["maquinas"].as<JsonArrayConst>();
  if (lista.isNull() || lista.size() != 2) {
    apiDisponible = false;
    apagarRgbPorConexion();
    Serial.println("API: se esperaban 2 maquinas en /api/estado");
    return false;
  }
  // /api/estado puede devolver un resumen PUBLICO (HTTP 200) sin cola.
  // La terminal debe recibir la vista PRIVADA con X-Terminal-Key.
  for (JsonObjectConst obj : lista) {
    if (!obj["cola"].is<JsonArrayConst>()) {
      Serial.println("API: vista publica. Revise la clave X-Terminal-Key.");
      apiDisponible = false;
      apagarRgbPorConexion();
      return false; // No sobrescribir las colas con listas vacias.
    }
  }
  for (JsonObjectConst obj : lista) {
    int m = (obj["id"] | 0) - 1;
    if (m < 0 || m > 1) continue;
    MaquinaRemota &dest = maquinasAPI[m];
    EstadoEquipo anterior = equipos[m].estado;
    dest.estado = String((const char*) (obj["estado"] | ""));
    dest.segundos = obj["segundos_restantes"] | 0;
    dest.ocupanteId = -1;
    dest.ocupanteNombre = "";
    dest.ocupanteIniciadas = 0;
    dest.ocupanteTotal = 0;
    JsonObjectConst ocupante = obj["ocupante"].as<JsonObjectConst>();
    if (!ocupante.isNull()) {
      dest.ocupanteId = ocupante["solicitud_id"] | -1;
      dest.ocupanteNombre = String((const char*)(ocupante["nombre"] | ""));
      dest.ocupanteIniciadas = ocupante["tandas_iniciadas"] | 0;
      dest.ocupanteTotal = ocupante["tandas_totales"] | 0;
    }
    dest.cantidad = 0;
    for (JsonObjectConst c : obj["cola"].as<JsonArrayConst>()) {
      if (dest.cantidad >= MAX_COLA_REMOTA) break;
      ItemRemoto &item = dest.cola[dest.cantidad++];
      item.id = c["solicitud_id"] | -1;
      item.nombre = String((const char*)(c["nombre"] | ""));
      item.estado = String((const char*)(c["estado"] | ""));
      item.iniciadas = c["tandas_iniciadas"] | 0;
      item.total = c["tandas_totales"] | 0;
      item.disponible = (c["disponible"] | true);
    }
    EstadoEquipo nuevo = LIBRE;
    if (dest.estado == "EN_USO") nuevo = EN_USO;
    else if (dest.estado == "PENDIENTE_RETIRO") nuevo = TERMINADO;
    else if (dest.estado == "ENTRE_TANDAS") nuevo = PREPARANDO;
    equipos[m].estado = nuevo;  // El RGB refleja el backend, no las colas demo.
    equipos[m].restantes = dest.segundos;
    sincronizacionMaquinaMs[m] = millis();

    // Una sola alerta de tres pitidos por solicitud/tanda terminada,
    // aunque la API pierda conexion o devuelva estados transitorios.
    if (apiSincronizada && anterior == EN_USO && nuevo == TERMINADO &&
        dest.ocupanteId >= 0 &&
        (ultimoAvisoSolicitud[m] != dest.ocupanteId ||
         ultimoAvisoTanda[m] != dest.ocupanteIniciadas)) {
      ultimoAvisoSolicitud[m] = dest.ocupanteId;
      ultimoAvisoTanda[m] = dest.ocupanteIniciadas;
      Serial.printf("AVISO FIN: maquina %d, tanda %d, 3 pitidos (solo una vez)\n",
                    m + 1, dest.ocupanteIniciadas);
      iniciarPitidos(3);
    }
  }
  if (!apiSincronizada) Serial.println("API REAL: /api/estado OK - Lavadora y secadora sincronizadas");
  apiDisponible = true;
  apiSincronizada = true;
  ultimoEstadoCorrectoMs = millis();
  actualizarLeds();

  // Actualizar 'Mi turno' utilizando la cola recibida en la misma solicitud.
  // Ya no hace falta POST /mi-turno cada 1.5 segundos.
  for (int m = 0; m < 2; ++m) {
    if (turnosCuenta[m].id < 0) continue;
    for (int i = 0; i < maquinasAPI[m].cantidad; ++i) {
      const ItemRemoto &item = maquinasAPI[m].cola[i];
      if (item.id == turnosCuenta[m].id) {
        turnosCuenta[m].estado = item.estado;
        turnosCuenta[m].iniciadas = item.iniciadas;
        turnosCuenta[m].total = item.total;
        turnosCuenta[m].posicion = i + 1;
        break;
      }
    }
  }
  return true;
}

// Recibir una fotografia remota en segundo plano sin bloquear los controles.
void tareaEstadoHTTP(void *parametro) {
  for (;;) {
    if (WiFi.status() == WL_CONNECTED) {
      String respuesta;
      int codigo = -1;
      unsigned long inicioPeticion = millis();
      peticionAPI("/api/estado", "GET", "", respuesta, codigo);
      if (mutexEstadoHTTP && xSemaphoreTake(mutexEstadoHTTP, pdMS_TO_TICKS(300)) == pdTRUE) {
        respuestaEstadoPendiente = respuesta;
        codigoEstadoPendiente = codigo;
        inicioConsultaEstadoPendienteMs = inicioPeticion;
        hayEstadoPendiente = true;
        xSemaphoreGive(mutexEstadoHTTP);
      }
    }
    vTaskDelay(pdMS_TO_TICKS(INTERVALO_API_MS));
  }
}

void prepararEstadoHTTP() {
  mutexEstadoHTTP = xSemaphoreCreateMutex();
  if (!mutexEstadoHTTP) {
    Serial.println("ERROR: sin memoria para mutex de estado");
    return;
  }
  if (xTaskCreate(tareaEstadoHTTP, "LR_estadoHTTP", 8192, nullptr, 1, nullptr) != pdPASS) {
    Serial.println("ERROR: no se pudo crear tarea HTTP de estado");
  }
}

// Tiempo de visualizacion local: el backend conserva toda la autoridad.
// Entre consultas de red descontamos visualmente 1 segundo por segundo.
unsigned long tiempoRestanteVisual(int m) {
  if (m < 0 || m > 1) return 0UL;
  const MaquinaRemota &datos = maquinasAPI[m];
  unsigned long restantes = datos.segundos > 0 ? (unsigned long)datos.segundos : 0UL;
  if (datos.estado != "EN_USO") return restantes;
  unsigned long transcurridos = (millis() - sincronizacionMaquinaMs[m]) / 1000UL;
  return transcurridos >= restantes ? 0UL : restantes - transcurridos;
}

// Devuelve el codigo y cuerpo al llamador, para distinguir PIN incorrecto,
// HTTP fallido y JSON invalido. Nunca imprime el PIN ni la clave terminal.
bool consultarMiTurnoAPI(const String &pin, bool guardar = true,
                        int *codigoSalida = nullptr, String *respuestaSalida = nullptr) {
  JsonDocument solicitud;
  solicitud["pin"] = pin;
  String cuerpo;
  serializeJson(solicitud, cuerpo);
  String respuesta;
  int codigo;
  bool exito = peticionAPI("/api/terminal/mi-turno", "POST", cuerpo, respuesta, codigo);
  if (codigoSalida) *codigoSalida = codigo;
  if (respuestaSalida) *respuestaSalida = respuesta;
  if (!exito) {
    apiDisponible = codigo > 0;
    Serial.println("API mi-turno: " + errorAPI(respuesta, codigo));
    return false;
  }

  JsonDocument doc;
  DeserializationError error = deserializeJson(doc, respuesta);
  if (error) {
    Serial.print("API mi-turno: JSON invalido: ");
    Serial.println(error.c_str());
    return false;
  }
  if (!guardar) return true;
  pinCuenta = pin;
  nombreCuenta = String((const char*)(doc["nombre"] | "Estudiante"));
  for (int i = 0; i < 2; ++i) turnosCuenta[i] = TurnoCuenta();
  for (JsonObjectConst s : doc["solicitudes"].as<JsonArrayConst>()) {
    int m = (s["maquina_id"] | 0) - 1;
    if (m < 0 || m > 1) continue;
    turnosCuenta[m].id = s["id"] | -1;
    turnosCuenta[m].estado = String((const char*)(s["estado"] | ""));
    turnosCuenta[m].iniciadas = s["tandas_iniciadas"] | 0;
    turnosCuenta[m].total = s["tandas_totales"] | 0;
    turnosCuenta[m].posicion = s["posicion"] | 0;
  }
  return true;
}

